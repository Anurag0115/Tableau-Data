      <table>
        <view>
          <datasources>
            <datasource name='Sample - Superstore' />
          </datasources>
          <datasource-dependencies datasource='Sample - Superstore'>
            <column caption='Profitable ' datatype='string' name='[Calculation_0356297416040487]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Profit]) &gt; 0 then &quot;Profitable&quot; ELSE &quot;Not Profitable&quot; END' />
            </column>
            <column caption='Profit/Loss' datatype='string' name='[Calculation_0356297416994856]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IIF(SUM([Profit])&gt;0,&quot;Profit&quot;,&quot;Loss&quot;)' />
            </column>
            <column caption='Sales Category' datatype='string' name='[Calculation_0356297417453609]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF SUM([Sales])&gt;= 20000 THEN &quot;EXCELLENT&quot;&#13;&#10;ELSEIF SUM([Sales]) &gt;=15000 THEN &quot;GOOD&quot;&#13;&#10;ELSEIF SUM([Sales])&gt;= 10000 THEN &quot;AVERAGE&quot;&#13;&#10;ELSE &quot;POOR&quot;&#13;&#10;END' />
            </column>
            <column datatype='real' name='[Profit]' role='measure' type='quantitative' />
            <column datatype='real' name='[Sales]' role='measure' type='quantitative' />
            <column datatype='string' name='[Sub-Category]' role='dimension' type='nominal' />
            <column-instance column='[Sub-Category]' derivation='None' name='[none:Sub-Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Sales]' derivation='Sum' name='[sum:Sales:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0356297416040487]' derivation='User' name='[usr:Calculation_0356297416040487:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0356297416994856]' derivation='User' name='[usr:Calculation_0356297416994856:nk]' pivot='key' type='nominal' />
