      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[Sample - Superstore].[usr:Calculation_0356297419776043:qk:1]&quot;' value='RANK' />
        </aliases>
      </column>
      <column caption='Fixed Category Sales' datatype='real' name='[Calculation_0356297375576064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED[Category]:SUM([Sales])}' />
      </column>
      <column caption='FIXED Sales' datatype='real' name='[Calculation_0356297376247809]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{fixed:SUM([Sales])}' />
      </column>
      <column caption='Include Category Sales' datatype='real' name='[Calculation_0356297382121474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{INCLUDE[Category]:SUM([Sales])}' />
      </column>
      <column caption='QTD sales ' datatype='real' name='[Calculation_0356297407213597 1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Order Date]&gt;=DATETRUNC(&quot;quarter&quot;,[Parameters].[Parameter 0356297406562331])&#13;&#10;and&#13;&#10;[Order Date]&lt;=[Parameters].[Parameter 0356297406562331] then [Sales]&#13;&#10;END' />
      </column>
      <column caption='YTD Sales ' datatype='real' name='[Calculation_0356297407213597]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Order Date]&gt;=DATETRUNC(&quot;year&quot;,[Parameters].[Parameter 0356297406562331])&#13;&#10;and&#13;&#10;[Order Date]&lt;=[Parameters].[Parameter 0356297406562331] then [Sales]&#13;&#10;END' />
      </column>
      <column caption='Previous Year Sales ' datatype='real' name='[Calculation_0356297412759590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='LOOKUP(SUM([Sales]),-1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profitable ' datatype='string' name='[Calculation_0356297416040487]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &gt; 0 then &quot;Profitable&quot; ELSE &quot;Not Profitable&quot; END' />
      </column>
      <column caption='Profit/Loss' datatype='string' name='[Calculation_0356297416994856]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF(SUM([Profit])&gt;0,&quot;Profit&quot;,&quot;Loss&quot;)' />
      </column>
      <column caption='Sales Category' datatype='string' name='[Calculation_0356297417453609]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales])&gt;= 20000 THEN &quot;EXCELLENT&quot;&#13;&#10;ELSEIF SUM([Sales]) &gt;=15000 THEN &quot;GOOD&quot;&#13;&#10;ELSEIF SUM([Sales])&gt;= 10000 THEN &quot;AVERAGE&quot;&#13;&#10;ELSE &quot;POOR&quot;&#13;&#10;END' />
      </column>
      <column caption='Category Group ' datatype='string' name='[Calculation_0356297418874922]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Category]&#13;&#10;WHEN &quot;Furniture&quot; THEN &quot;A&quot;&#13;&#10;WHEN &quot;Office Supplies&quot; then &quot;B&quot;&#13;&#10;ELSE &quot;C&quot;&#13;&#10;END' />
      </column>
      <column caption='RANK' datatype='integer' name='[Calculation_0356297419776043]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]),&apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Running Total' datatype='real' name='[Calculation_0356297420906540]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
