      <column caption='First Purchase Quarter' datatype='date' datatype-customized='true' name='[Calculation_0332933113221120]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE({FIXED[Customer Name]: min(DATETRUNC(&quot;quarter&quot;,[Order Date]))})' />
      </column>
      <column aggregation='Sum' caption='Customer per First Quarter' datatype='integer' name='[Calculation_0332933114925057]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{FIXED[Calculation_0332933113221120]: COUNTD([Customer Name])}' />
      </column>
      <column caption='Retention%' datatype='real' name='[Calculation_0332933115928578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer ID])/SUM([Calculation_0332933114925057])' />
      </column>
      <column caption='Date Range' datatype='boolean' name='[Calculation_0688350197358595]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Order Date]&gt;=[Parameters].[Parameter 0688350196686849] and [Order Date]&lt;=[Parameters].[Parameter 0688350196961282]' />
      </column>
      <column caption='Chart Selection' datatype='string' name='[Calculation_0688350201270277]' role='dimension' type='nominal'>
