      </column>
      <column caption='Total Sales' datatype='real' name='[Calculation_0688350209728520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if year ([Order Date]) = [Parameters].[Parameter 0688350209171463] then [Sales]end)' />
      </column>
      <column caption='Total Quantity' datatype='integer' name='[Calculation_0688350210269193]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if year([Order Date])= [Parameters].[Parameter 0688350209171463] then [Quantity]end)' />
      </column>
      <column caption='Total Profit' datatype='real' name='[Calculation_0688350210580490]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if year([Order Date])= [Parameters].[Parameter 0688350209171463] then [Profit]end)' />
      </column>
      <column caption='Fix Total' datatype='real' name='[Calculation_0688350213971979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED : SUM(IF YEAR([Order Date]) = [Parameters].[Parameter 0688350209171463] THEN [Sales] END)}' />
      </column>
      <column caption='Fix Quantity' datatype='integer' name='[Calculation_0688350214844428]' role='measure' type='quantitative'>
